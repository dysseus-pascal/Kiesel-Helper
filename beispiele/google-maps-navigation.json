{
  "format": 2,
  "name": "Google Maps → Kieselweg",
  "beschreibung": "Schickt die Navigationsanweisung von Google Maps an die Uhr-App Kieselweg. UNGEPRÜFT: die Feldaufteilung von Maps ist noch nicht nachgemessen — mit tools/felder_messen.ps1 nachsehen und hier anpassen.",

  "quelle": { "art": "benachrichtigung", "paket": "com.google.android.apps.maps" },

  "schluessel": {
    "ANWEISUNG": 10000,
    "ENTFERNUNG": 10001,
    "STRASSE": 10002
  },

  "regeln": [
    {
      "wenn": ["titel", "text"],
      "nur_wenn": { "titel": "[0-9]" },
      "nicht_zweimal_fuer": "text",
      "senden": {
        "an": "888e2bc3-f95a-40ce-ac86-01eeeded7d36",
        "starten": true,
        "felder": {
          "ANWEISUNG":  { "aus": "text",  "art": "text" },
          "STRASSE":    { "aus": "untertext", "art": "text" },
          "ENTFERNUNG": { "aus": "titel", "art": "zahl", "muster": "([0-9.,]+)" }
        }
      },
      "meldung": "{text} in {titel}"
    }
  ]
}
