{
  "format": 2,
  "name": "OsmAnd → Kieselweg",
  "beschreibung": "Schickt die Navigationsanweisung von OsmAnd an die Uhr-App Kieselweg. NACHGEMESSEN an net.osmand.plus: OsmAnd legt Entfernung UND Anweisung in denselben Titel (\"80 m • Turn right and go\"), getrennt durch einen Aufzählungspunkt; Text und Untertext sind leer, und android.progress steht auf 0 und ist damit unbrauchbar. ZUSATZ trägt hier nicht die Strasse, sondern Restweg • Restzeit • Ankunft aus der zweiten Zeile des Grosstexts — die Strasse steht nur eingebettet in der Anweisungszeile und wäre ohne Sprachwissen nicht sauber herauszulösen.",

  "quelle": { "art": "benachrichtigung", "paket": "net.osmand.plus" },

  "schluessel": {
    "ANWEISUNG": 10000,
    "ENTFERNUNG": 10001,
    "ZUSATZ": 10002
  },

  "regeln": [
    {
      "wenn": ["titel", "grosstext"],
      "nur_wenn": { "titel": "^[0-9]+([.,][0-9]+)?\\s*m\\s*•" },
      "senden": {
        "an": "888e2bc3-f95a-40ce-ac86-01eeeded7d36",
        "starten": true,
        "hoechstens_alle_s": 10,
        "felder": {
          "ANWEISUNG":  { "aus": "titel", "art": "text", "muster": "•\\s*(.+)$" },
          "ENTFERNUNG": { "aus": "titel", "art": "zahl", "muster": "^\\s*([0-9]+(?:[.,][0-9]+)?)\\s*m\\s*•" },
          "ZUSATZ":     { "aus": "grosstext", "art": "text", "muster": "\\n\\s*(.+)$" }
        }
      },
      "meldung": "{titel}"
    },

    {
      "wenn": ["titel", "grosstext"],
      "nur_wenn": { "titel": "^[0-9]+([.,][0-9]+)?\\s*km\\s*•" },
      "senden": {
        "an": "888e2bc3-f95a-40ce-ac86-01eeeded7d36",
        "starten": true,
        "hoechstens_alle_s": 10,
        "felder": {
          "ANWEISUNG":  { "aus": "titel", "art": "text", "muster": "•\\s*(.+)$" },
          "ENTFERNUNG": { "aus": "titel", "art": "zahl", "muster": "^\\s*([0-9]+(?:[.,][0-9]+)?)\\s*km\\s*•", "faktor": 1000 },
          "ZUSATZ":     { "aus": "grosstext", "art": "text", "muster": "\\n\\s*(.+)$" }
        }
      },
      "meldung": "{titel}"
    },

    {
      "ausloeser": "verschwindet",
      "wenn": ["paket"],
      "senden": {
        "an": "888e2bc3-f95a-40ce-ac86-01eeeded7d36",
        "felder": {
          "ANWEISUNG":  { "wert": "Navigation beendet", "art": "text" },
          "ENTFERNUNG": { "wert": -1, "art": "zahl" },
          "ZUSATZ":     { "wert": "", "art": "text" }
        }
      },
      "meldung": "Navigation beendet"
    }
  ]
}
