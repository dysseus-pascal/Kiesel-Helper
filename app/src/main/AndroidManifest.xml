<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DER KATALOG.
         ============
         Dies ist der einzige Teil von Kiesel-Helper, den eine Beschreibung
         NICHT erweitern kann. Berechtigungen stehen im Manifest und werden
         beim Installieren festgeschrieben; eine nachgeladene Beschreibung
         kann keine hinzufuegen. Was hier fehlt, kostet eine neue Fassung der
         App - alles andere kostet nur einen Zettel.

         Deshalb steht hier ein VORRAT und nicht nur das heute Gebrauchte.
         Aufgenommen ist, was eine Pebble-Uhr wirklich hergibt; nicht
         aufgenommen ist, wofuer eine Uhr ein schlechtes Eingabegeraet waere
         (Gewicht, Blutdruck, Koerpertemperatur - das tippt man am Telefon).

           HERZRATENVARIABILITAET  Herzintervall, in Gebrauch
           WASSER                  Drinktervall, in Gebrauch
           HERZFREQUENZ            der Sensor liegt ohnehin am Handgelenk
           ERNAEHRUNG              fuer Koffein und Praeparate (SupCycle)
           SCHRITTE                zaehlt die Uhr von Haus aus
           SCHLAF                  Herzintervall misst ohnehin nachts

         GELESEN WIRD NICHTS. Kiesel-Helper traegt nur ein. Eine Leseerlaubnis
         waere eine ungleich groessere Offenlegung und wird von nichts
         gebraucht, was diese App tut. -->
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_VO2_MAX" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.WRITE_WHEELCHAIR_PUSHES" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />

    <!-- Neu gegenueber der Vorgaenger-App: die Beschreibungen kommen aus dem
         Netz. Geholt wird nur, wenn jemand den Knopf drueckt - nie von selbst
         im Hintergrund. Eine stille Aenderung an dem, was in eine
         Gesundheitsakte schreibt, waere genau das, was man nicht will. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Der Empfaenger muss zur LAUFZEIT angemeldet sein (impliziter Broadcast,
         siehe EmpfangsDienst), und das braucht einen laufenden Prozess. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse und NICHT dataSync. Zwei Regeln von Android 15 machen
         dataSync hier unbrauchbar: ein dataSync-Dienst darf aus einem
         BOOT_COMPLETED-Empfaenger gar nicht erst gestartet werden
         (ForegroundServiceStartNotAllowedException), und er darf nur sechs
         Stunden je vierundzwanzig laufen. Beides zusammen heisst: nach einem
         Neustart kaeme der Empfang nie wieder hoch, und im Betrieb waere er
         nach einem Vierteltag weg. specialUse hat keine der beiden Grenzen und
         verlangt keine Vorbedingung - nur eine Begruendung im Manifest. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ab Android 11 muss ausdruecklich stehen, welche fremden Pakete man
         ansprechen will - sonst sind sie unsichtbar. Health Connect ist bis
         Android 13 eine eigene App, ab 14 Teil des Systems. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_myplaces"
        android:label="@string/app_name"
        android:theme="@style/KieselTheme">

        <activity
            android:name=".HauptActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect verlangt, dass die App erklaeren kann, wozu sie
                 die Erlaubnis braucht (bis Android 13). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Dasselbe ab Android 14, wo Health Connect im System steckt. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HauptActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Der zweite Bildschirm: eine Beschreibung einbinden. Getrennt vom
             ersten, damit dort nur steht, was gerade eintraegt. -->
        <activity
            android:name=".EinbindenActivity"
            android:exported="false"
            android:parentActivityName=".HauptActivity" />

        <!-- Meldet den Empfaenger zur Laufzeit an und haelt ihn am Leben. -->
        <service
            android:name=".EmpfangsDienst"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Nimmt Messungen entgegen, die die Pebble-App als impliziten Broadcast verschickt. Ein solcher Broadcast erreicht nur einen zur Laufzeit angemeldeten Empfaenger, und der braucht einen laufenden Prozess." />
        </service>

        <!-- ZWEITE QUELLE: die Benachrichtigungen des Telefons.

             Das ist die Komponente, die ein Zettel NICHT nachreichen koennte -
             und der Grund, warum sie schon jetzt hier steht, obwohl noch kein
             Zettel sie benutzt. Ein NotificationListenerService ist ausserdem
             die staerkste Hintergrund-Primitive, die Android hergibt: das
             System bindet ihn selbst, bindet nach Neustart und nach Abstuerzen
             neu, ohne Vordergrunddienst und ohne Zeitgrenze.

             BIND_NOTIFICATION_LISTENER_SERVICE steht hier als android:permission
             und NICHT als <uses-permission>: sie schuetzt den Dienst davor, von
             irgendwem gebunden zu werden, sie wird nicht von uns erbeten. Die
             Freigabe erteilt der Benutzer in den Systemeinstellungen. -->
        <service
            android:name=".BenachrichtigungsHorcher"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Nach einem Neustart den Dienst wieder hochfahren, sonst verpasst
             man die naechste Messung, ohne es zu merken. -->
        <receiver
            android:name=".StartEmpfaenger"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Der Eintrag im Manifest bleibt, schadet nicht und greift auf
             Android 7 und aelter. Ab Android 8 erreicht ihn der implizite
             Broadcast der Pebble-App NICHT - dafuer ist der Dienst da. -->
        <receiver
            android:name=".PebbleEmpfaenger"
            android:exported="true">
            <intent-filter>
                <action android:name="com.getpebble.action.app.RECEIVE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
