<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WAS DIE APP MIT DER GESUNDHEITSAKTE TUT.
         ================================
         Fuenf Dinge SCHREIBEN, zehn LESEN. Frueher standen hier 22
         Schreibrechte als Vorrat: die App konnte damals Beschreibungen
         nachladen, und was im Manifest fehlt, kann keine Beschreibung
         nachreichen. Seit die Aufgaben fest im Code stehen, ist der Vorrat
         nur noch Laerm - zwanzig ungenutzte Rechte im Berechtigungsdialog
         sehen aus, als wolle die App mehr, als sie braucht.

         GELESEN WIRD JETZT DOCH, und das ist eine ungleich groessere
         Offenlegung als das Schreiben. Der Grund steht auf dem
         Gesundheits-Schirm: die Akte selbst ist ueberladen und zeigt darum
         nichts zuerst. Diese App zeigt acht Zahlen und sonst nichts - dafuer
         muss sie sie lesen duerfen. -->
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />
    <!-- Koffein und genommene Praeparate. Die Akte fuehrt beides als
         Ernaehrung; einen eigenen Satz fuer "genommen" hat sie nicht. -->
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <!-- Trainingssitzungen von Kieselsport. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <!-- Die Strecke gehoert an die Trainingssitzung; dafuer verlangt die
         Akte ein eigenes Recht. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE_ROUTE" />

    <!-- STANDORT: NUR WAEHREND EINES TRAININGS. Die Uhr hat kein GPS; die
         Strecke kann nur das Telefon aufzeichnen. Der Dienst dafuer laeuft
         ausschliesslich zwischen Start und Stop eines Trainings und zeigt
         dabei eine Meldung in der Leiste - wer den Standort eines Menschen
         aufzeichnet, soll das nicht lautlos tun koennen.

         ACCESS_BACKGROUND_LOCATION, schweren Herzens. Es war zuerst nicht
         da, mit dem Gedanken, der Vordergrunddienst genuege. Er genuegt
         nicht: das Training beginnt auf der UHR, das Telefon liegt dabei in
         der Tasche und die App ist zu. In diesem Zustand laesst Android
         einen Ortungsdienst ohne dieses Recht nicht zu - die Strecke bliebe
         leer, und niemand wuesste warum. Es wird einzeln erfragt, erst wenn
         jemand eine Strecke will, und geortet wird trotzdem nur zwischen
         Start und Stop: ohne Training keine Messung. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />

    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <!-- Aelter als dreissig Tage: ohne sie gibt die Akte nach einer
         Neuinstallation nur den letzten Monat heraus. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Der Empfaenger muss zur LAUFZEIT angemeldet sein (impliziter Broadcast,
         siehe EmpfangsDienst), und das braucht einen laufenden Prozess. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse und NICHT dataSync. Zwei Regeln von Android 15 machen
         dataSync hier unbrauchbar: ein dataSync-Dienst darf aus einem
         BOOT_COMPLETED-Empfaenger gar nicht erst gestartet werden
         (ForegroundServiceStartNotAllowedException), und er darf nur sechs
         Stunden je vierundzwanzig laufen. Beides zusammen heisst: nach einem
         Neustart kaeme der Empfang nie wieder hoch, und im Betrieb waere er
         nach einem Vierteltag weg. specialUse hat keine der beiden Grenzen und
         verlangt keine Vorbedingung - nur eine Begruendung im Manifest. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ab Android 11 muss ausdruecklich stehen, welche fremden Pakete man
         ansprechen will - sonst sind sie unsichtbar. Health Connect ist bis
         Android 13 eine eigene App, ab 14 Teil des Systems. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>

        <!-- OSMAND. Ohne diese drei Zeilen ist es fuer uns nicht vorhanden:
             bindService findet den Dienst nicht, gibt false zurueck, und die
             App meldet "kein OsmAnd gefunden" - auf einem Telefon, auf dem es
             installiert ist und laeuft.

             Genau so ist es passiert. Der Fehler ist besonders heimtueckisch,
             weil nichts abstuerzt und nichts warnt: die Sichtbarkeitsregel gilt
             seit Android 11 stillschweigend, und der einzige Hinweis steht im
             Logcat, das man am Steuer nicht liest.

             Drei Pakete, weil es OsmAnd dreifach gibt - die gekaufte Fassung,
             die freie und die naechtliche. -->
        <package android:name="net.osmand.plus" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.dev" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_myplaces"
        android:label="@string/app_name"
        android:theme="@style/KieselTheme">

        <activity
            android:name=".HauptActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect verlangt, dass die App erklaeren kann, wozu sie
                 die Erlaubnis braucht (bis Android 13). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Dasselbe ab Android 14, wo Health Connect im System steckt. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HauptActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- KARTENLINKS NACH OSMAND.
             ========================
             Android gibt uns diese Links NICHT von selbst: seit Android 12
             muss eine App den Besitz einer Adresse nachweisen, um sie zu
             beanspruchen, und fuer google.com kann das niemand ausser Google.
             Der Mensch muss die Verknuepfung deshalb einmal von Hand
             erlauben, unter "Standardmaessig oeffnen -> Links hinzufuegen".

             Das ist richtig so. Eine App, die sich unbemerkt vor fremde Links
             setzen koennte, waere ein Angriffswerkzeug. -->
        <activity
            android:name=".KartenlinkActivity"
            android:exported="true"
            android:label="Nach OsmAnd"
            android:launchMode="singleTask"
            android:excludeFromRecents="true">

            <!-- ZWEI FILTER, NICHT EINER - und das ist kein Schoenheitsfehler.
                 Alle <data>-Zeilen INNERHALB eines Filters werden von Android
                 zu EINER Bedingung verschmolzen: jedes Schema mal jeden Host
                 mal jeden Pfad. Stand irgendwo ein pathPrefix, galt er damit
                 fuer ALLE Hosts des Filters.

                 Genau das war hier der Fall: "/maps" stand wegen
                 www.google.com im selben Filter wie maps.app.goo.gl - und ein
                 Kurzlink hat als Pfad "/abc123". Er passte also auf keine
                 Bedingung und kam nie an. Getrennt nach "mit Pfad" und "ohne
                 Pfad" stimmt beides. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="maps.google.com" />
                <data android:host="maps.app.goo.gl" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="www.google.com" />
                <data android:host="google.com" />
                <data android:host="goo.gl" />
                <data android:pathPrefix="/maps" />
            </intent-filter>

            <!-- geo: gehoert niemandem und braucht keine Freigabe. Darueber
                 reichen andere Apps Orte weiter - das geht sofort. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <!-- Die Technik, aus dem Weg geraeumt. Sie war ein Reiter und stand
             damit jeden Tag daneben, obwohl man sie zweimal im Jahr
             braucht. -->
        <activity
            android:name=".EinstellungenActivity"
            android:exported="false"
            android:parentActivityName=".HauptActivity" />

        <!-- Der Trend hinter einer Karte: die Antwort auf "ist das viel?". -->
        <activity
            android:name=".TrendActivity"
            android:exported="false"
            android:parentActivityName=".HauptActivity" />

        <!-- Die aelteren Trainings, und eines davon im Einzelnen. -->
        <activity
            android:name=".VergangeneActivity"
            android:exported="false"
            android:parentActivityName=".HauptActivity" />

        <!-- Was die App getan hat, als niemand hinsah. -->
        <activity
            android:name=".VerlaufActivity"
            android:exported="false"
            android:parentActivityName=".HauptActivity" />

        <!-- Meldet den Empfaenger zur Laufzeit an und haelt ihn am Leben. -->
        <service
            android:name=".EmpfangsDienst"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Nimmt Messungen entgegen, die die Pebble-App als impliziten Broadcast verschickt. Ein solcher Broadcast erreicht nur einen zur Laufzeit angemeldeten Empfaenger, und der braucht einen laufenden Prozess." />
        </service>

        <!-- DER BENACHRICHTIGUNGS-HORCHER IST WEG. Er las die Meldung von
             OsmAnd mit, weil das der einzige Weg zu den Abbiegedaten schien.
             Seit die App OsmAnd ueber dessen eigene Schnittstelle fragt, ist er
             ueberfluessig - und mit ihm die unangenehmste Freigabe, die diese
             App je verlangt hat: Zugriff auf JEDE Benachrichtigung des
             Telefons, fuer eine Handvoll Zahlen. -->

        <!-- Nach einem Neustart UND nach einem Update den Dienst wieder
             hochfahren, sonst verpasst man die naechste Messung, ohne es zu
             merken. -->
        <receiver
            android:name=".StartEmpfaenger"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Der Eintrag im Manifest bleibt, schadet nicht und greift auf
             Android 7 und aelter. Ab Android 8 erreicht ihn der implizite
             Broadcast der Pebble-App NICHT - dafuer ist der Dienst da. -->
        <receiver
            android:name=".PebbleEmpfaenger"
            android:exported="true">
            <intent-filter>
                <action android:name="com.getpebble.action.app.RECEIVE" />
            </intent-filter>
        </receiver>

        <!-- Zeichnet die Strecke auf, solange ein Training laeuft. -->
        <service
            android:name=".SpurDienst"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Das Widget. exported="true" ist Pflicht: den Broadcast schickt
             der Startbildschirm, also ein fremder Prozess. -->
        <receiver
            android:name=".GesundheitWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gesundheit_info" />
        </receiver>

    </application>
</manifest>
