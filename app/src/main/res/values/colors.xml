<?xml version="1.0" encoding="utf-8"?>
<!-- Kiesel: heller Stein, ein Wasserton als Akzent.
     Eigene Farben statt der Systemfarben, weil DeviceDefault auf neueren
     Telefonen Material You aufgreift - dort wurde die ganze App rosa, mit
     Schrift, die kaum vom Grund abstand. -->
<resources>
    <color name="grund">#F3F4F1</color>
    <color name="karte">#FFFFFF</color>
    <color name="linie">#E3E5E0</color>

    <color name="schrift">#1C2226</color>
    <color name="schrift_zart">#5D666C</color>

    <!-- DREI AKZENTE, EINER JE REITER. Der Wasserton bleibt der der
         Gesundheit; Training bekommt einen warmen Erdton, Ernaehrung einen
         Moosgruen. Sie sind gleich tief und gleich leise - es soll kein
         Reiter lauter sein als die anderen, nur unterscheidbar. -->
    <color name="akzent">#3A6B79</color>
    <color name="akzent_gedrueckt">#2C5361</color>
    <color name="akzent_schrift">#FFFFFF</color>

    <color name="akzent_training">#8A5A2B</color>
    <color name="akzent_training_gedrueckt">#6C4620</color>

    <color name="akzent_ernaehrung">#41693B</color>
    <color name="akzent_ernaehrung_gedrueckt">#31512D</color>

    <color name="gut_grund">#E2EFE8</color>
    <color name="gut_schrift">#1F6244</color>
    <color name="warn_grund">#FAE7DC</color>
    <color name="warn_schrift">#8E3D12</color>

    <!-- Die Schlafphasen. Drei Toene desselben Wassers von tief nach flach,
         und ein warmer fuer WACH - das Wachliegen gehoert nicht dazu und soll
         auch nicht so aussehen. -->
    <color name="phase_tief">#24505F</color>
    <color name="phase_rem">#7A6FA8</color>
    <color name="phase_leicht">#8FBECB</color>
    <color name="phase_wach">#C98A5E</color>

    <!-- Was ueber dem selbst gesetzten Ideal liegt. Gruenlich, aber leise:
         es ist eine Auskunft, kein Lob. -->
    <color name="ueber_ziel">#6FA88C</color>

    <!-- DIE SPORTARTEN. Eine Familie warmer Erdtoene um den Trainingston,
         dazu zwei kuehle fuer das, was nicht auf Erde stattfindet: Yoga und
         Wasser. Jede Art erkennt man im Kalender und in der Woche an ihrer
         Farbe, ohne die Legende zu lesen. -->
    <color name="sport_lauf">#C0582B</color>
    <color name="sport_bike">#B7862A</color>
    <color name="sport_wandern">#6E7F3A</color>
    <color name="sport_kraft">#8A3B2E</color>
    <color name="sport_yoga">#7A4E7E</color>
    <color name="sport_schwimmen">#2E7C8A</color>
    <color name="sport_anderes">#7D6B5D</color>

    <!-- DIE ERNAEHRUNG IN IHREN STOFFEN. Wasser blau, auch im gruenen Reiter -
         ein gruenes Glas Wasser saehe nach etwas anderem aus. Koffein im
         Ton von Kaffee, die Praeparate im Moos des Reiters. -->
    <color name="wasser">#3E8EB8</color>
    <color name="koffein">#7B4B2A</color>
</resources>
