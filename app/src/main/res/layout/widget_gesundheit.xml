<?xml version="1.0" encoding="utf-8"?>
<!-- Das Widget: vier Zahlen mit Balken, eine leise Zeile darunter.

     VIER UND NICHT ACHT. Auf dem Startbildschirm liest man im Vorbeigehen;
     was einen Balken hat, hat auch ein Ziel, und nur dafuer lohnt der Blick.
     Ruhepuls und HRV stehen ohne Balken in der Fusszeile - sie haben kein
     Ziel, an dem man sie messen koennte.

     Kein Compose, kein Glance: ein Widget ist RemoteViews, und die kennen nur
     eine Handvoll Klassen. LinearLayout, TextView, ProgressBar - mehr braucht
     es hier nicht. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_grund"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/schrift_zart"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- WIE ALT, NICHT WANN. "21:12" beantwortet die Frage nicht, die man
             am Widget hat - die lautet "ist das noch aktuell". Hier stehen
             ganze Minuten; die Sekunden eines Chronometers waren genauer, als
             die Frage es verlangt, und unruhiger als noetig.

             Weitergezaehlt wird im Minutentakt des Systems, den der laufende
             Dienst ohnehin bekommt - siehe EmpfangsDienst. -->
        <TextView
            android:id="@+id/w_stand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="@color/schrift_zart"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/w_auffrischen"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:padding="5dp"
            android:src="@drawable/ic_auffrischen"
            android:contentDescription="@string/widget_auffrischen" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schritte"
                android:textColor="@color/schrift_zart"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_schritte_wert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/schrift"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/w_schritte_balken"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_balken" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktiv"
                android:textColor="@color/schrift_zart"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_aktiv_wert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/schrift"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/w_aktiv_balken"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_balken" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schlaf"
                android:textColor="@color/schrift_zart"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_schlaf_wert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/schrift"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/w_schlaf_balken"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_balken" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wasser"
                android:textColor="@color/schrift_zart"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_wasser_wert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/schrift"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/w_wasser_balken"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_balken" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_fuss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:textColor="@color/schrift_zart"
        android:textSize="12sp" />
</LinearLayout>
