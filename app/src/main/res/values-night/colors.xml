<?xml version="1.0" encoding="utf-8"?>
<!-- Dasselbe Bild bei Nacht: nasser Stein statt hellem.
     Der Akzent muss hier HELLER sein als der Grund, nicht dunkler - sonst
     verschwindet er. Und weil er hell ist, wird die Schrift auf dem gefuellten
     Knopf dunkel; akzent_schrift dreht sich also mit um. -->
<resources>
    <color name="grund">#14181A</color>
    <color name="karte">#1E2427</color>
    <color name="linie">#313A3E</color>

    <color name="schrift">#E9ECEA</color>
    <color name="schrift_zart">#9BA5A9</color>

    <color name="akzent">#6FB3C4</color>
    <color name="akzent_gedrueckt">#8FC9D8</color>
    <color name="akzent_schrift">#0D1214</color>

    <!-- Auch die beiden anderen muessen bei Nacht HELLER sein als der
         Grund, sonst verschwinden sie. -->
    <color name="akzent_training">#D2A05E</color>
    <color name="akzent_training_gedrueckt">#E2B87F</color>

    <color name="akzent_ernaehrung">#8FBE7A</color>
    <color name="akzent_ernaehrung_gedrueckt">#A8D296</color>

    <color name="gut_grund">#1A3129</color>
    <color name="gut_schrift">#86D6AC</color>
    <color name="warn_grund">#372219</color>
    <color name="warn_schrift">#EDA87E</color>

    <!-- Bei Nacht heller: auf dunklem Grund verschwindet ein tiefes Blau. -->
    <color name="phase_tief">#3E7D91</color>
    <color name="phase_rem">#9B8ED0</color>
    <color name="phase_leicht">#A7D2DD</color>
    <color name="phase_wach">#DDA06F</color>

    <!-- Bei Nacht heller, sonst verschwindet es im dunklen Balken. -->
    <color name="ueber_ziel">#84C4A4</color>
</resources>
